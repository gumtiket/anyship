# 서비스 서버에서 복사해 값을 채운다. 실제 파일(*.tfvars)은 .gitignore 대상이라 커밋되지 않는다.
#
#   cp terraform.tfvars.example test.tfvars
#   ./tf.sh plan -var-file=test.tfvars
#
# 여기에는 비밀이 없다(공개 키, 이메일, IP, 계정 ID). 다만 계정 ID와 IP가 들어가므로 올리지 않는다.
# External ID와 임시 자격 증명은 이 파일에 쓰지 않는다. tf.sh가 환경변수로만 다룬다.

# 인프라를 만들 리전. 온보딩 스택의 state 버킷과 같은 리전을 쓰면 단순하다.
region = "ap-northeast-2"

# 대상 사용자 계정의 12자리 ID. provider가 이 계정에서만 실행되도록 고정한다.
account_id = "000000000000"

# 환경 ID. init 때 넘기는 state key(<환경ID>/foundation.tfstate)와 같은 값이어야 한다.
# 소문자, 숫자, 하이픈 2~21자.
env_id = "test"

# 서비스 서버의 탄력적 IP(단일 주소, CIDR 아님). 호스트의 SSH(22)를 이 주소에만 연다.
service_server_ip = "203.0.113.10"

# 서비스 서버 배포 키의 공개 키 한 줄(ssh-ed25519 ...). 개인 키는 절대 넣지 않는다.
ssh_public_key = "ssh-ed25519 AAAA... service-server-deploy"

# Let's Encrypt 발급 연락 주소.
acme_email = "you@example.com"

# 아래는 기본값이 있다. 바꿀 때만 주석을 푼다.
# vpc_cidr             = "10.20.0.0/16"
# host_instance_type   = "t3.small"   # t3.small | t3.medium | t3.large
# host_volume_size     = 30           # 20~100 GiB
# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20           # 20~100 GiB
