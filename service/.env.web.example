# AnyShip local GitHub profile. Copy to .env.github.local, or use scripts/start-local.ps1.
APP_ENV=development
APP_DEMO=false
APP_AI_MODE=placeholder
# Real engine: bronze. none=rules only; fake=offline model fixture (development only).
# See docs/AI_INTEGRATION.md for optional AI dependencies and model credentials.
APP_AI_PROVIDER=none
APP_AI_TIMEOUT=300
APP_AI_MAX_CALLS=12
APP_AI_WORKSPACE=
# Explicit development-only simulation; no AWS/SSH calls. Default: unavailable.
APP_DEPLOYMENT_MODE=unavailable
APP_MOCK_STEP_DELAY=0.3
APP_APP_ORIGIN=http://localhost:8000
# Empty: start-local prepares the project-local PostgreSQL database.
# External DB: postgresql+psycopg://USER:PASSWORD@HOST:5432/anyship
APP_DATABASE_URL=
# GitHub login and repository/PR operations are real. Only AI output is temporary.
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITHUB_APP_SLUG=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_TOKEN_KEY=

# AWS onboarding is enabled only when all three values are set (and APP_DEMO=false).
# Use an accessible, versioned S3 template URL provided by the infrastructure owner.
APP_AWS_TEMPLATE_URL=
APP_AWS_SERVICE_ROLE_ARN=
# Comma-separated commercial AWS regions, e.g. ap-northeast-2,us-east-1
APP_AWS_REGIONS=
# Matches the current infrastructure's sts:AssumeRole resource restriction.
# Optional {id} generates a unique name; the service role policy must allow that pattern first.
APP_AWS_ROLE_NAME=deploy-service-role
# Empty (default): the AWS "connection check" is not wired (aws_verification_available=false).
# sts: verify the cross-account role with STS (AssumeRole, External ID required, account match)
# using this server's own AWS credentials, e.g. the service server's instance role.
APP_AWS_VERIFY=

# Real deployments (APP_DEPLOYMENT_MODE=real; requires APP_DEMO=false). Missing or malformed values stop the server at startup.
# Where the source comes from. github (default): the connected repository's branch is fetched from GitHub with the user's token
# (shallow clone; the repository needs Dockerfile and deploy-spec.yaml at its root). local: use already-fetched sources from
# APP_DEPLOY_SOURCE_DIR, a sub-folder named like the repository (for testing).
APP_DEPLOY_SOURCE=github
# Only for APP_DEPLOY_SOURCE=local.
APP_DEPLOY_SOURCE_DIR=
# Private key used to reach the application hosts. The public key is read from the same path + ".pub".
APP_DEPLOY_SSH_KEY=
# This server's public IP: the only address allowed to SSH into the hosts.
APP_DEPLOY_SERVICE_IP=
# Contact address for Let's Encrypt (Traefik).
APP_DEPLOY_ACME_EMAIL=
# Apps are served at <app>.<env id>.aws.<this domain>.
APP_DEPLOY_BASE_DOMAIN=
# on (default): the service keeps the wildcard DNS record *.<env id>.aws.<domain> pointed at the environment's host
# (Route 53, via this server's instance role). off: manage that record by hand.
APP_DEPLOY_DNS=on
# Optional. Defaults: infra/user-account in this repository, ~/.terraform.d/plugin-cache, TLS verification on.
# Set APP_DEPLOY_VERIFY_TLS=false only while testing with Let's Encrypt staging certificates.
APP_DEPLOY_TERRAFORM_DIR=
APP_DEPLOY_PLUGIN_CACHE=
# Where fetched sources are kept briefly while a deployment runs (default: service/workspaces/deploy-src).
APP_DEPLOY_WORKSPACE=
APP_DEPLOY_VERIFY_TLS=true
